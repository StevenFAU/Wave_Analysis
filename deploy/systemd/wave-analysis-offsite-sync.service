# Daily exchange of data/raw with an rclone remote (e.g. Cloudflare R2): the
# offsite copy, and how collector hosts share images (pushes, then pulls).
# Needs WAVE_ANALYSIS_REMOTE, e.g. "r2:wave-analysis-raw", in
# ~/.config/wave-analysis/sync.env (see docs/operations/data_collection.md).
[Unit]
Description=Wave_Analysis: offsite copy of the raw archive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@REPO@
EnvironmentFile=%h/.config/wave-analysis/sync.env
# rclone may be installed per user (e.g. ~/.local/bin), which systemd's PATH lacks.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@REPO@/scripts/sync_offsite.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=6h
